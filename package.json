{
  "name": "studio-project-manila",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Project Manila — recording sessions, pay periods and payouts",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
